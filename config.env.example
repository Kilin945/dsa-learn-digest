# 複製成 config.env（已被 .gitignore），填入你的設定。
# Gmail App Password 不放這裡，改存 macOS Keychain（見 README）。
GMAIL_USER="you@gmail.com"
MAIL_TO="you@gmail.com"
KEYCHAIN_SERVICE="dsa-learn-gmail"

# 學習目標：給 claude 產課與決定深度用
LEARN_GOAL="讓讀者確實理解資料結構與演算法（DSA），並能實際用在工作上——寫程式的人做出更好的選擇，跟工程師共事的人聽得懂、問得對"

# Notion 同步（可選）：填入筆記父頁面 ID，每天自動建子頁；留空則略過。
# token 存 Keychain（見 README）；不設這兩項則略過 Notion 同步。
NOTION_PARENT_PAGE_ID=""
NOTION_KEYCHAIN_SERVICE="dsa-learn-notion"

# 執行環境（可選，預設見 run_learn.sh）
# CLAUDE_BIN="$HOME/.local/bin/claude"
# PYTHON_BIN="/opt/homebrew/bin/python3"
# CLAUDE_MODEL="sonnet"
